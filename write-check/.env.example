# LanguageTool Docker endpoint (default: http://localhost:8010)
LT_URL=http://localhost:8010

# Personal dictionary file (one word per line)
DICTIONARY_FILE=./dictionary.txt

# Server port
PORT=3800

# LLM API (optional — needed only for the rewrite pane)
# Supports OpenAI-compatible APIs (OpenAI, Anthropic via compat, Ollama, etc.)
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
